# RouteX Mobile Configuration
# Team: NextGen | Product: RouteX

# The base URL of the running RouteX web application
# Android Emulator (computer localhost from emulator): http://10.0.2.2:5173
# Physical Android device on local Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:5173 (e.g. http://192.168.1.100:5173)
# Local web development testing: http://localhost:5173
# Production / Staging deployment: https://routex.app
EXPO_PUBLIC_WEB_URL=

# The base URL of the running RouteX backend API (/api/v1)
# Android Emulator (computer localhost from emulator): http://10.0.2.2:8000/api/v1
# Physical Android device on local Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:8000/api/v1 (e.g. http://192.168.0.178:8000/api/v1)
# Local web development testing: http://localhost:8000/api/v1
# Production: https://routex.app/api/v1
EXPO_PUBLIC_API_URL=
