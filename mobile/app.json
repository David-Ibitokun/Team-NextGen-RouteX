{
  "expo": {
    "name": "RouteX",
    "slug": "routex",
    "scheme": "routex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#142B3B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.routex.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RouteX uses your location to place and view nearby road hazard reports accurately.",
        "NSCameraUsageDescription": "RouteX uses the camera to allow capturing photographic evidence of road hazards.",
        "NSPhotoLibraryUsageDescription": "RouteX uses your photo library to attach photos to road hazard reports."
      }
    },
    "android": {
      "package": "org.routex.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RouteX requires access to your photos to attach evidence to road hazard reports.",
          "cameraPermission": "RouteX requires camera access so you can photograph road hazards on the spot."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#087F8C"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cba537cb-ae17-4519-bb11-8259d6017b5b"
      }
    },
    "owner": "david_ibitokun"
  }
}
