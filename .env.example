# Django Backend Settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Database Settings
# Set USE_POSTGRES=
USE_POSTGRES=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Media and Uploads
MEDIA_URL=
MAX_UPLOAD_SIZE_MB=

# Google Gemini AI (Backend only; disabled by default)
GEMINI_AI_ENABLED=
GEMINI_API_KEY=

# Frontend Configuration
# Keep this empty for LAN development so the browser uses Vite's /api proxy.
VITE_API_BASE_URL=

# Email API Configuration
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_TIMEOUT=
FRONTEND_URL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TEST_RESET_EMAIL=

# Carto Maps API Configuration
CARTO_API_KEY=