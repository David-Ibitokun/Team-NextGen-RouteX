# ==============================================================================
# RouteX Environment Configuration Template (.env.example)
# Team: NextGen | Product: RouteX | Pilot: Lagos, Nigeria
#
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials, database passwords, or secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Backend Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL default; SQLite local fallback supported)
# To use PostgreSQL, set USE_POSTGRES=True and configure connection details.
# If USE_POSTGRES=False, a local development SQLite database is used.
# ------------------------------------------------------------------------------
USE_POSTGRES=False
DB_NAME=routex_db
DB_USER=routex_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Or specify a full DATABASE_URL (e.g., postgresql://user:pass@localhost:5432/routex_db)
# DATABASE_URL=postgresql://routex_user:your_secure_db_password@localhost:5432/routex_db

# ------------------------------------------------------------------------------
# CORS and CSRF Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Media and File Uploads
# ------------------------------------------------------------------------------
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=5

# ------------------------------------------------------------------------------
# Future Phase: Google Gemini AI (Backend-only, gated behind feature flag)
# ------------------------------------------------------------------------------
GEMINI_AI_ENABLED=False
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Settings (Vite client)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
